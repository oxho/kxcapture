<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
    <key>NSHumanReadableCopyright</key><string>${SNOW_SHOT_COPYRIGHT}</string>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>io.github.oxho.kxcapture.mini</string>
    <key>CFBundleName</key><string>KXCapture Mini</string>
    <key>CFBundleDisplayName</key><string>KXCapture Mini</string>
    <key>LSUIElement</key><true/>
    <key>CFBundleIconFile</key><string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <!-- Qt catalogs live in resources; AppKit needs the supported languages here. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
    </array>
    <key>CFBundleVersion</key><string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleShortVersionString</key><string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>LSMinimumSystemVersion</key><string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSAppleEventsUsageDescription</key><string>KXCapture Mini reads selected image files from Finder to pin them to the screen.</string>
    <key>NSCameraUsageDescription</key><string>KXCapture Mini records webcam video when you enable webcam recording for a screen recording.</string>
    <key>NSMicrophoneUsageDescription</key><string>KXCapture Mini records microphone audio when you enable it for a screen recording.</string>
    <key>NSAudioCaptureUsageDescription</key><string>KXCapture Mini captures system audio when you enable it for a screen recording.</string>
    <key>SUFeedURL</key><string>${SNOW_SPARKLE_MINI_APPCAST_URL}</string>
    <key>SnowSparkleMirrorFeedURL</key><string>${SNOW_SPARKLE_MINI_MIRROR_APPCAST_URL}</string>
    <key>SUPublicEDKey</key><string>${SNOW_SPARKLE_PUBLIC_KEY}</string>
    <key>SUEnableAutomaticChecks</key><false/>
    <key>SUAutomaticallyUpdate</key><false/>
    <key>SUAllowsAutomaticUpdates</key><false/>
    <key>SUVerifyUpdateBeforeExtraction</key><true/>
    <key>SURequireSignedFeed</key><true/>
    <key>SUEnableSystemProfiling</key><false/>
</dict>
</plist>
